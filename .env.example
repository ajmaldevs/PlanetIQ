# ==========================================
# PlanetIQ Environment Configuration Template
# Copy this file to .env and supply actual credentials.
# NEVER commit the active .env file to Git!
# ==========================================

# Core Application Settings
PROJECT_NAME="PlanetIQ"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","https://planetiq-1.onrender.com"]

# ==========================================
# Database Configuration (PostgreSQL + PostGIS)
# ==========================================
# 1. DATABASE_URL is the primary connection string used across PlanetIQ backend and Alembic.
#
# A) Local Development:
# DATABASE_URL="postgresql://terralens_user:your_secure_password_here@localhost:5432/terralens_db"
#
# B) Render Deployed Backend Service (Render Internal Network):
# Uses Render's private service DNS (e.g., dpg-dbv2tp8m7kps73a36tog-a) without bandwidth charges:
# DATABASE_URL="postgresql://planetiq_database_user:password@dpg-dbv2tp8m7kps73a36tog-a/planetiq_database"
#
# C) Local Migration / pg_dump / pg_restore to Render (External Host):
# Render's internal host (dpg-...) cannot be resolved from outside Render. For local pg_restore or Alembic:
# DATABASE_URL="postgresql://planetiq_database_user:password@dpg-dbv2tp8m7kps73a36tog-a.frankfurt-postgres.render.com/planetiq_database?sslmode=require"
#
DATABASE_URL="postgresql://terralens_user:your_secure_password_here@localhost:5432/terralens_db"

# Fallback discrete parameters (used if DATABASE_URL is not set):
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="terralens_user"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_DB="terralens_db"

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ==========================================
# NASA Earthdata & Scientific APIs
# ==========================================
# Register at https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME="your_earthdata_username"
NASA_EARTHDATA_PASSWORD="your_earthdata_password"
NASA_EARTHDATA_BEARER_TOKEN="your_earthdata_token_optional"
NASA_CMR_ENDPOINT="https://cmr.earthdata.nasa.gov/search"

# ==========================================
# Google Gemini API (Scientific Assistant)
# ==========================================
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_API_BASE_URL="http://localhost:8000/api/v1"
