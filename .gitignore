# ==========================================
# TerraLens (PlanetIQ) .gitignore
# ==========================================

# Environment variables & secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
credentials.json
token.json
service-account*.json

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Node.js & Frontend build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
frontend/test-results/
frontend/playwright-report/
frontend/test-artifacts/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Geospatial & Large Scientific Data (HDF5, NetCDF, GeoTIFF, etc.)
*.nc
*.nc4
*.h5
*.hdf
*.hdf5
*.grib
*.grib2
*.tif
*.tiff
*.geotiff
*.grb
*.grb2
*.bin
*.tar.gz
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Database & PostGIS
*.sqlite
*.sqlite3
*.db
pgdata/
docker/data/

# OS & Editor files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
